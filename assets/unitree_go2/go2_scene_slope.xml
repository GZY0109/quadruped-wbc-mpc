<mujoco model="go2 scene (wbc-mpc, slope terrain)">
  <!-- Phase 3(B) terrain variant: same scene as go2_scene.xml, floor geom
       tilted 5 deg about the world y-axis (pitch-slope, rising along +x --
       a realistic ramp-grade angle, comparable to accessibility-ramp specs
       of ~3-5 deg). The controller (src/mpc.py, src/wbc.py) is unmodified
       and still assumes a horizontal ground normal (0,0,1) in its
       friction-cone / foothold-height logic -- this scene exists
       specifically to measure how much that flat-ground assumption
       degrades performance under a real slope, not to give the controller
       terrain awareness. Even mild slopes turned out to be hard for this
       controller in isolated testing (a static-stance probe at 3/5/8/12
       deg all showed collapse within a few seconds even with zero added
       noise) -- 5 deg was chosen as a realistic, not cherry-picked-for-
       survival, representative angle; see PROGRESS.md for the actual
       multi-seed results.
       compiler angle="radian" is inherited from go2.xml's <compiler>, so
       the euler angle below is in radians (5 deg = 0.08727 rad). -->
  <include file="go2.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" euler="0 0.08727 0"/>
  </worldbody>

  <sensor>
    <framequat     name="imu_quat"  objtype="site" objname="imu"/>
    <gyro          name="imu_gyro"  site="imu"/>
    <accelerometer name="imu_acc"   site="imu"/>
    <framepos      name="base_pos"     objtype="site" objname="imu"/>
    <framelinvel   name="base_linvel"  objtype="site" objname="imu"/>
    <frameangvel   name="base_angvel"  objtype="site" objname="imu"/>

    <touch name="FL_touch" site="FL_foot"/>
    <touch name="FR_touch" site="FR_foot"/>
    <touch name="RL_touch" site="RL_foot"/>
    <touch name="RR_touch" site="RR_foot"/>

    <framepos name="FL_pos" objtype="site" objname="FL_foot"/>
    <framepos name="FR_pos" objtype="site" objname="FR_foot"/>
    <framepos name="RL_pos" objtype="site" objname="RL_foot"/>
    <framepos name="RR_pos" objtype="site" objname="RR_foot"/>
  </sensor>
</mujoco>
