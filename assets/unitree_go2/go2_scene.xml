<mujoco model="go2 scene (wbc-mpc)">
  <!-- Project scene: vendored Unitree Go2 model + flat floor + IMU/foot sensors.
       The Go2 MJCF is from google-deepmind/mujoco_menagerie (BSD-3, see
       unitree_go2/LICENSE); foot sites were added locally for WBC swing tracking
       and contact sensing. Rough-terrain / slope variants for Phase 3 will
       include this file and override the <geom name="floor"> heightfield. -->
  <include file="go2.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <!-- Sensors. IMU sensors reference the "imu" site defined in go2.xml; foot
       sensors reference the *_foot sites added to each calf body. These mirror
       what is available on the real Go2 (IMU + foot force estimate) so the
       controller only consumes signals a physical robot could provide. -->
  <sensor>
    <!-- Base IMU (on trunk) -->
    <framequat     name="imu_quat"  objtype="site" objname="imu"/>
    <gyro          name="imu_gyro"  site="imu"/>
    <accelerometer name="imu_acc"   site="imu"/>
    <!-- Privileged base state (ground-truth; used for logging/eval, not fed to the controller as-is) -->
    <framepos      name="base_pos"     objtype="site" objname="imu"/>
    <framelinvel   name="base_linvel"  objtype="site" objname="imu"/>
    <frameangvel   name="base_angvel"  objtype="site" objname="imu"/>

    <!-- Foot contact normal force (scalar) -->
    <touch name="FL_touch" site="FL_foot"/>
    <touch name="FR_touch" site="FR_foot"/>
    <touch name="RL_touch" site="RL_foot"/>
    <touch name="RR_touch" site="RR_foot"/>

    <!-- Foot world positions (for swing-leg tracking / debugging) -->
    <framepos name="FL_pos" objtype="site" objname="FL_foot"/>
    <framepos name="FR_pos" objtype="site" objname="FR_foot"/>
    <framepos name="RL_pos" objtype="site" objname="RL_foot"/>
    <framepos name="RR_pos" objtype="site" objname="RR_foot"/>
  </sensor>
</mujoco>
