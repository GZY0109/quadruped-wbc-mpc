<mujoco model="go2 scene (wbc-mpc, rough terrain)">
  <!-- Phase 3(B) terrain variant: same scene as go2_scene.xml, floor geom
       replaced with a heightfield (assets/unitree_go2/rough_hfield.png,
       generated by scripts/gen_rough_terrain.py -- smoothed random noise,
       fixed seed, ~3cm peak-to-peak bumps). The controller is unmodified
       and still assumes a flat, horizontal ground normal in its
       friction-cone / foothold-height logic -- this scene measures how
       much that assumption degrades performance under real bumps, not to
       give the controller terrain awareness. -->
  <include file="go2.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <!-- size = [radius_x, radius_y, elevation_z, base_z] meters: 3x3m field,
         0.03m (3cm) peak height, 0.05m solid base below the lowest point. -->
    <hfield name="rough" nrow="64" ncol="64" size="3 3 0.03 0.05" file="rough_hfield.png"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="hfield" hfield="rough" material="groundplane"/>
  </worldbody>

  <sensor>
    <framequat     name="imu_quat"  objtype="site" objname="imu"/>
    <gyro          name="imu_gyro"  site="imu"/>
    <accelerometer name="imu_acc"   site="imu"/>
    <framepos      name="base_pos"     objtype="site" objname="imu"/>
    <framelinvel   name="base_linvel"  objtype="site" objname="imu"/>
    <frameangvel   name="base_angvel"  objtype="site" objname="imu"/>

    <touch name="FL_touch" site="FL_foot"/>
    <touch name="FR_touch" site="FR_foot"/>
    <touch name="RL_touch" site="RL_foot"/>
    <touch name="RR_touch" site="RR_foot"/>

    <framepos name="FL_pos" objtype="site" objname="FL_foot"/>
    <framepos name="FR_pos" objtype="site" objname="FR_foot"/>
    <framepos name="RL_pos" objtype="site" objname="RL_foot"/>
    <framepos name="RR_pos" objtype="site" objname="RR_foot"/>
  </sensor>
</mujoco>
